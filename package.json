{
  "name": "context-quarantine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic admission firewall for persistent AI-agent memory.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm --filter @contextquarantine/core build && pnpm --filter @contextquarantine/cli build && pnpm --filter @contextquarantine/studio build",
    "dev": "pnpm --filter @contextquarantine/studio dev",
    "lint": "eslint .",
    "typecheck": "tsc -b packages/core/tsconfig.build.json packages/cli/tsconfig.build.json && tsc -p apps/studio/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "precontextq": "pnpm --filter @contextquarantine/core build && pnpm --filter @contextquarantine/cli build",
    "contextq": "node packages/cli/dist/index.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
